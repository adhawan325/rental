<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1" author="rental">
        <createTable tableName="EMAIL_VERIFICATION_TOKEN">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_EMAIL_VERIFICATION_TOKEN"/>
            </column>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="USER_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="TOKEN" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="TOKEN_TYPE" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="EXPIRY_DATE" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="USED" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="USED_DATE" type="DATETIME"/>
            <column name="CREATED_DATE" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="IP_ADDRESS" type="VARCHAR(45)"/>
        </createTable>
    </changeSet>
    <changeSet id="2" author="rental">
        <addColumn tableName="RENTAL_USER">
            <column name="ACCOUNT_STATUS" type="VARCHAR(20)"/>
            <column name="EMAIL_VERIFIED" type="BOOLEAN"/>
            <column name="EMAIL_VERIFIED_DATE" type="DATETIME"/>
            <column name="REGISTRATION_DATE" type="DATETIME"/>
        </addColumn>
    </changeSet>
    <changeSet id="3" author="rental">
        <addColumn tableName="USER_SUBSCRIPTION">
            <column name="STRIPE_CHECKOUT_SESSION_ID" type="VARCHAR(255)"/>
            <column name="STRIPE_PRICE_ID" type="VARCHAR(255)"/>
        </addColumn>
    </changeSet>
    <changeSet id="4" author="rental">
        <createIndex indexName="IDX_EMAIL_VERIFICATION_TOKEN_TOKEN" tableName="EMAIL_VERIFICATION_TOKEN" unique="true">
            <column name="TOKEN"/>
        </createIndex>
    </changeSet>
    <changeSet id="5" author="rental">
        <createIndex indexName="IDX_EMAIL_VERIFICATION_TOKEN_USER" tableName="EMAIL_VERIFICATION_TOKEN">
            <column name="USER_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="USER_ID" baseTableName="EMAIL_VERIFICATION_TOKEN"
                                 constraintName="FK_EMAIL_VERIFICATION_TOKEN_ON_USER" referencedColumnNames="ID"
                                 referencedTableName="RENTAL_USER"/>
    </changeSet>
</databaseChangeLog>
