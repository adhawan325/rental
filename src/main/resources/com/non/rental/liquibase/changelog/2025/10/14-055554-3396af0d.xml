<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1" author="rental">
        <createTable tableName="CALCULATED_METRICS">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_CALCULATED_METRICS"/>
            </column>
            <column name="RENTAL_ANALYSIS_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="MONTHLY_CASH_FLOW" type="DECIMAL(19, 2)"/>
            <column name="ANNUAL_CASH_FLOW" type="DECIMAL(19, 2)"/>
            <column name="CASH_ON_CASH_RETURN" type="DOUBLE"/>
            <column name="CAP_RATE" type="DOUBLE"/>
            <column name="GROSS_YIELD" type="DOUBLE"/>
            <column name="NET_YIELD" type="DOUBLE"/>
            <column name="TOTAL_ROI" type="DOUBLE"/>
            <column name="DEBT_SERVICE_COVERAGE_RATIO" type="DOUBLE"/>
            <column name="BREAK_EVEN_RATIO" type="DOUBLE"/>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="2" author="rental">
        <createTable tableName="EXPENSE_PROJECTION">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_EXPENSE_PROJECTION"/>
            </column>
            <column name="RENTAL_ANALYSIS_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="ANNUAL_PROPERTY_TAX" type="DECIMAL(19, 2)"/>
            <column name="ANNUAL_INSURANCE" type="DECIMAL(19, 2)"/>
            <column name="MONTHLY_HOA_FEES" type="DECIMAL(19, 2)"/>
            <column name="PROPERTY_MANAGEMENT_PERCENT" type="DOUBLE"/>
            <column name="PROPERTY_MANAGEMENT_AMOUNT" type="DECIMAL(19, 2)"/>
            <column name="MAINTENANCE_PERCENT" type="DOUBLE"/>
            <column name="MAINTENANCE_AMOUNT" type="DECIMAL(19, 2)"/>
            <column name="CAP_EX_PERCENT" type="DOUBLE"/>
            <column name="CAP_EX_AMOUNT" type="DECIMAL(19, 2)"/>
            <column name="MONTHLY_UTILITIES" type="DECIMAL(19, 2)"/>
            <column name="OTHER_MONTHLY_EXPENSES" type="DECIMAL(19, 2)"/>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="3" author="rental">
        <createTable tableName="FINANCING_DETAILS">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_FINANCING_DETAILS"/>
            </column>
            <column name="RENTAL_ANALYSIS_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="LOAN_AMOUNT" type="DECIMAL(19, 2)"/>
            <column name="INTEREST_RATE" type="DOUBLE">
                <constraints nullable="false"/>
            </column>
            <column name="LOAN_TERM_YEARS" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="POINTS_PAID" type="DOUBLE"/>
            <column name="MONTHLY_PAYMENT" type="DECIMAL(19, 2)"/>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="4" author="rental">
        <createTable tableName="INCOME_PROJECTION">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_INCOME_PROJECTION"/>
            </column>
            <column name="RENTAL_ANALYSIS_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="MONTHLY_RENT" type="DECIMAL(19, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="OTHER_MONTHLY_INCOME" type="DECIMAL(19, 2)"/>
            <column name="VACANCY_RATE" type="DOUBLE">
                <constraints nullable="false"/>
            </column>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="5" author="rental">
        <createTable tableName="PURCHASE_DETAILS">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_PURCHASE_DETAILS"/>
            </column>
            <column name="RENTAL_ANALYSIS_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="PURCHASE_PRICE" type="DECIMAL(19, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="DOWN_PAYMENT_AMOUNT" type="DECIMAL(19, 2)"/>
            <column name="DOWN_PAYMENT_PERCENT" type="DOUBLE"/>
            <column name="CLOSING_COSTS" type="DECIMAL(19, 2)"/>
            <column name="CLOSING_COSTS_PERCENT" type="DOUBLE"/>
            <column name="RENOVATION_COSTS" type="DECIMAL(19, 2)"/>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="6" author="rental">
        <createTable tableName="RENTAL_ANALYSIS">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_RENTAL_ANALYSIS"/>
            </column>
            <column name="USER_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="PROPERTY_ADDRESS" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="PROPERTY_ID" type="VARCHAR(500)"/>
            <column name="ANALYSIS_NAME" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="CREATED_DATE" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="LAST_MODIFIED_DATE" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="STATUS" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="7" author="rental">
        <createIndex indexName="IDX_RENTAL_ANALYSIS_PROPERTY_ID" tableName="RENTAL_ANALYSIS">
            <column name="PROPERTY_ID"/>
        </createIndex>
    </changeSet>
    <changeSet id="8" author="rental">
        <createIndex indexName="IDX_RENTAL_ANALYSIS_STATUS" tableName="RENTAL_ANALYSIS">
            <column name="STATUS"/>
        </createIndex>
    </changeSet>
    <changeSet id="9" author="rental">
        <createIndex indexName="IDX_RENTAL_ANALYSIS_USER" tableName="RENTAL_ANALYSIS">
            <column name="USER_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="USER_ID" baseTableName="RENTAL_ANALYSIS"
                                 constraintName="FK_RENTAL_ANALYSIS_ON_USER" referencedColumnNames="ID"
                                 referencedTableName="RENTAL_USER"/>
    </changeSet>
    <changeSet id="10" author="rental">
        <addForeignKeyConstraint baseColumnNames="RENTAL_ANALYSIS_ID" baseTableName="CALCULATED_METRICS"
                                 constraintName="FK_CALCULATED_METRICS_ON_RENTAL_ANALYSIS" referencedColumnNames="ID"
                                 referencedTableName="RENTAL_ANALYSIS"/>
    </changeSet>
    <changeSet id="11" author="rental">
        <addForeignKeyConstraint baseColumnNames="RENTAL_ANALYSIS_ID" baseTableName="EXPENSE_PROJECTION"
                                 constraintName="FK_EXPENSE_PROJECTION_ON_RENTAL_ANALYSIS" referencedColumnNames="ID"
                                 referencedTableName="RENTAL_ANALYSIS"/>
    </changeSet>
    <changeSet id="12" author="rental">
        <addForeignKeyConstraint baseColumnNames="RENTAL_ANALYSIS_ID" baseTableName="FINANCING_DETAILS"
                                 constraintName="FK_FINANCING_DETAILS_ON_RENTAL_ANALYSIS" referencedColumnNames="ID"
                                 referencedTableName="RENTAL_ANALYSIS"/>
    </changeSet>
    <changeSet id="13" author="rental">
        <addForeignKeyConstraint baseColumnNames="RENTAL_ANALYSIS_ID" baseTableName="INCOME_PROJECTION"
                                 constraintName="FK_INCOME_PROJECTION_ON_RENTAL_ANALYSIS" referencedColumnNames="ID"
                                 referencedTableName="RENTAL_ANALYSIS"/>
    </changeSet>
    <changeSet id="14" author="rental">
        <addForeignKeyConstraint baseColumnNames="RENTAL_ANALYSIS_ID" baseTableName="PURCHASE_DETAILS"
                                 constraintName="FK_PURCHASE_DETAILS_ON_RENTAL_ANALYSIS" referencedColumnNames="ID"
                                 referencedTableName="RENTAL_ANALYSIS"/>
    </changeSet>
</databaseChangeLog>
